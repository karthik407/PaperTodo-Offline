{
"kind": "native",
"id": "sample.focus-timer.native",
"name": "Focus Timer",
"description": "A WPF Pomodoro timer that integrates with PaperTodo tasks, supporting task completion syncing, automatic selection of the next item, and background timing.",
"version": "1.4.0",
"apiVersion": "2.1",
"stateVersion": 3,
"entry": "PaperTodo.Plugin.FocusTimer.dll",
"capabilities": [
"textZoom"
],
"permissions": [
"papers.read",
"papers.observe",
"todos.read",
"todos.observe",
"todos.update"
],
"settingCategories": [
{
"name": "Integration",
"column": "left"
},
{
"name": "Display",
"column": "left"
},
{
"name": "Timing",
"column": "right"
}
],
"settings": [
{
"id": "autoStartNext",
"type": "boolean",
"name": "Auto-start next phase",
"description": "Automatically start a break after a focus session ends, and start a focus session after a break ends.",
"default": false,
"category": "Integration"
},
{
"id": "showLinkedTodo",
"type": "boolean",
"name": "Show linked task",
"description": "Display a PaperTodo task selector within the timer that syncs in real-time.",
"default": true,
"category": "Integration"
},
{
"id": "completeLinkedTodo",
"type": "boolean",
"name": "Complete task after focus session",
"description": "Mark the currently linked task as complete upon finishing a full focus session; skipping the session does not trigger this.",
"default": false,
"category": "Integration"
},
{
"id": "autoSelectNextTodo",
"type": "boolean", "name": "Select next item upon completion",
"description": "After automatically completing a linked task, select the next unfinished task based on card order.",
"default": false,
"category": "Integration"
},
{
"id": "showProgress",
"type": "boolean",
"name": "Show progress bar",
"default": true,
"category": "Display"
},
{
"id": "showCompleted",
"type": "boolean",
"name": "Show completion stats",
"default": true,
"category": "Display"
},
{
"id": "focusMinutes",
"type": "number",
"name": "Default focus duration",
"default": 25,
"min": 1,
"max": 180,
"step": 1,
"suffix": "minutes",
"category": "Timer"
},
{
"id": "breakMinutes",
"type": "number",
"name": "Default break duration",
"default": 5,
"min": 1,
"max": 180,
"step": 1,
"suffix": "minutes",
"category": "Timer"
},
{
"id": "adjustStep",
"type": "number",
"name": "Adjustment step",
"default": 5,
"min": 1,
"max": 30,
"step": 1,
"suffix": "minutes",
"category": "Timer"
},
{
"id": "dailyGoal",
"type": "number",
"name": "Daily goal",
"description": "0 means only the completion count is displayed, without the goal.",
"default": 4,
"min": 0,
"max": 24,
"step": 1,
"suffix": "sessions",
"category": "Timer"
},
{ "id": "sound",
"type": "select",
"name": "Completion Sound",
"default": "asterisk",
"options": [
{
"value": "none",
"name": "Silent"
},
{
"value": "beep",
"name": "Beep"
},
{
"value": "asterisk",
"name": "Notification"
},
{
"value": "exclamation",
"name": "Alert"
}
],
"category": "Timer"
},
{
"id": "titleStyle",
"type": "select",
"name": "Capsule Title",
"default": "task",
"options": [
{
"value": "task",
"name": "Task & Countdown"
},
{
"value": "countdown",
"name": "Phase & Countdown"
},
{
"value": "status",
"name": "Phase Status Only"
},
{
"value": "fixed",
"name": "Fixed Title"
}
],
"category": "Display"
},
{
"id": "confirmReset",
"type": "boolean",
"name": "Confirm Before Reset",
"default": true,
"category": "Timer"
}
],
"advancedSettings": true,
"primarySettings": 2
}